---
import Base from '../layouts/Base.astro';
import { Content } from '../../BUILD.md';
---
<Base title="Build log · Shannon Hecker">
  <main id="main" class="band">
    <div class="wrap build-log measure">
      <p class="eyebrow"><a href="/">← Shannon Hecker</a></p>
      <Content />
    </div>
  </main>
</Base>
<style is:global>
  .build-log{display:grid;gap:20px;max-width:72ch;margin-inline:auto}
  .build-log h1{font-size:clamp(44px,6vw,96px);letter-spacing:-.05em;margin-bottom:12px}
  .build-log h2{font-size:clamp(28px,3vw,44px);margin-top:40px}
  .build-log h3{font-size:clamp(22px,2vw,30px);margin-top:24px}
  .build-log ul{list-style:disc;padding-left:1.2em;display:grid;gap:8px}
  .build-log code{font-size:.9em;background:var(--bg-2);padding:1px 6px;border-radius:4px}
</style>
