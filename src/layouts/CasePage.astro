---
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CaseRowLink from '../components/CaseRowLink.astro';
import { CASES } from '../lib/cases';
import { CASE_WORLD } from '../lib/journey';

interface Props { title: string; href: string }
const { title, href } = Astro.props;
const i = CASES.findIndex((c) => c.href === href);
// Description is the case's own index-row text: no new copy.
const description = CASES[i].meta;
// Each case with a world in the game links to it (World map in the hero).
const level = href in CASE_WORLD ? CASE_WORLD[href] + 1 : 0;
const next = CASES[(i + 1) % CASES.length];
---
<Base title={`${title} · Shannon Hecker`} description={description}>
  <div class="progress" aria-hidden="true"></div>
  <a class="skip" href="#main">Skip to content</a>
  <Nav />
  <main id="main" class="case-page" data-project={href.slice(1)}>
    <slot />
    {level > 0 && (
      <p class="wrap play-link"><a href={`/panel?level=${level}#top`}>Play this chapter in the game →</a></p>
    )}
    <section class="band next-case" aria-label="Next case">
      <div class="wrap"><div class="index"><CaseRowLink c={next} /></div></div>
    </section>
  </main>
  <Footer />
</Base>
<script>
  import '../scripts/motion.ts';
  import '../scripts/demo.ts';
  import '../scripts/marquee.ts';
</script>
