---
import { CASES } from '../lib/cases';
import CaseRowLink from './CaseRowLink.astro';

---
<section id="work" data-tone="light" class="band">
  <div class="wrap">
    <div class="g" style="row-gap:40px;margin-bottom:clamp(48px,6vw,96px)">
      <h2 class="work-title">Selected work</h2><p class="eyebrow work-method">Five cases, one method</p>
      <p class="work-description">Every case runs the same beats. Problem, constraints, decisions and their trade-offs, the full flow, the edge states, the outcome.</p>
    </div>
    <div class="index">
      {CASES.map((c) => <CaseRowLink c={c} homeArtwork />)}
    </div>
  </div>
</section>
