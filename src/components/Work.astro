---
import Pic from './Pic.astro';
import Split from './Split.astro';
import { peekSrc } from '../lib/img';

const names = ['fx-cover.jpg', 'fusion-cover.jpg', 'ws-marketing.jpg', 'fx-action.jpg'];
const peeks: Record<string, string> = Object.fromEntries(await Promise.all(names.map(async (n) => [n, await peekSrc(n)])));
---
<div class="peek" aria-hidden="true"><img src={peeks["fx-cover.jpg"]} alt="" width="840" height="473" loading="lazy" decoding="async"></div>
<section id="work" data-tone="light" class="band">
  <div class="wrap">
    <div class="g" style="row-gap:40px;margin-bottom:clamp(48px,6vw,96px)">
      <p class="eyebrow" style="grid-column:1/4">Three cases, one method</p>
      <Split as="h2" class="h-section" style="grid-column:4/12" text="Every case runs the same six beats. Problem, constraints, decisions and their trade-offs, the full flow, the edge states, the outcome." />
    </div>
    <div class="index">
      <a class="row" href="#fx" data-peek={peeks["fx-cover.jpg"]} data-cursor="big">
        <span class="n">01</span>
        <h3>FX execution analytics</h3>
        <span class="meta">Barclays · 2025 to now · in beta. Five spreadsheets and a static chart became one chart a trader can act from.</span>
        <span class="arrow">Read →</span>
        <Pic name="fx-cover.jpg" alt="" sizes="100vw" widths={[480, 800, 1200]} />
      </a>
      <a class="row" href="#fusion" data-peek={peeks["fusion-cover.jpg"]} data-cursor="big">
        <span class="n">02</span>
        <h3>Fusion analytics dashboard</h3>
        <span class="meta">J.P. Morgan · 2023 to 2025 · shipped. Board-ready analytics on Salt, zero accessibility violations, opened to clients in phase two.</span>
        <span class="arrow">Read →</span>
        <Pic name="fusion-cover.jpg" alt="" sizes="100vw" widths={[480, 800, 1200]} />
      </a>
      <a class="row" href="#winking" data-peek={peeks["ws-marketing.jpg"]} data-cursor="big">
        <span class="n">03</span>
        <h3>Winking Star</h3>
        <span class="meta">Solo · live on the App Store · v1.0.4. A warm, ad-free routine app for families. Designed, built and shipped by me.</span>
        <span class="arrow">Read →</span>
        <Pic name="ws-marketing.jpg" alt="" sizes="100vw" widths={[480, 800, 1200]} />
      </a>
      <a class="row" href="#ai" data-peek={peeks["fx-action.jpg"]} data-cursor="big">
        <span class="n">04</span>
        <h3>uoaui.ai and how I use AI</h3>
        <span class="meta">Private alpha. A design platform on Claude that builds screens from real design systems, and where a designer still matters.</span>
        <span class="arrow">Read →</span>
        <Pic name="fx-action.jpg" alt="" sizes="100vw" widths={[480, 800, 1200]} />
      </a>
    </div>
  </div>
</section>
