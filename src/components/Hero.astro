---
interface Props { revolut?: boolean }
const { revolut = false } = Astro.props;
import Pic from './Pic.astro';
---
<header id="top" data-tone="light" class="hero">
  <div class="wrap">
    {revolut && (
      // DECISION: The brief gives the line but not its spot. It sits above the
      // intro as a small eyebrow so the signed-off composition is untouched.
      <p class="eyebrow hero-for">Portfolio for the Revolut design panel</p>
    )}
    <p class="hero-top">Hi, I'm Shannon Hecker, a product designer in London. Lead design for FX and MarketsOne at Barclays, VP of Product Design at J.P. Morgan before that. I build what I design.</p>
    <div class="hero-grid">
      <div>
        <h1 class="h-giant anim"><span class="ln" style="--i:0"><span>I design tools</span></span><span class="ln" style="--i:1"><span>where mistakes</span></span><span class="ln" style="--i:2"><span>cost money.</span></span></h1>
        <div class="status-row" role="group" aria-label="Status">
          <span><i></i>Winking Star · live on the App Store</span>
          <span><i class="amber"></i>FX analytics · beta at Barclays</span>
          <span><i class="amber"></i>uoaui.ai · private alpha</span>
        </div>
      </div>
      <div class="hero-art anim"><Pic name="fx-cover.jpg" alt="FX execution analytics: a trading chart with progress and price on one canvas" sizes="(max-width: 1100px) 100vw, 34vw" eager /></div>
    </div>
  </div>
  <div class="ticker" aria-hidden="true">
    <div class="ticker-track">
      <span>Problem</span><span>Constraints</span><span>Explorations</span><span>Decisions and trade-offs</span><span>Full flows</span><span>Edge states</span><span>Outcomes</span>
      <span>Problem</span><span>Constraints</span><span>Explorations</span><span>Decisions and trade-offs</span><span>Full flows</span><span>Edge states</span><span>Outcomes</span>
    </div>
  </div>
</header>
