---
// The game lives in the hero, the way a playable Doodle sits on Google's home
// page: optional, idle until pressed, and the headline stays the main thing.
// It tells Shannon's career as a world map, Kaohsiung to AI. Every card states
// facts from her CV or her own words; nothing here is invented.
// DECISION: Named "Working Order" (a live order still filling; also "things in
// working order"). Mario-era pixel style, every noun from her own story.
import Pic from './Pic.astro';
import { JOURNEY, CHAPTERS, stageCode, nextLabel } from '../lib/journey';
---
<div class="play" data-lenis-prevent>
  <button type="button" class="game-exit" id="game-exit" hidden><span class="game-exit-label">Exit full screen</span> <span aria-hidden="true">✕</span></button>
  <p class="game-rotate" aria-hidden="true">Turn your phone sideways for a bigger game</p>
  <div class="game" data-state="poster">
    <canvas id="game" width="480" height="270" tabindex="-1" role="application" aria-roledescription="game" aria-label="Working Order" aria-describedby="game-desc"></canvas>
    <div class="game-poster">
      <Pic name="working-order-cover.png" alt="" sizes="(max-width: 1100px) 90vw, 480px" widths={[480, 960, 1344]} eager />
      <video class="game-cover-motion" muted playsinline preload="none" aria-hidden="true" tabindex="-1" data-src="/media/working-order-cover.mp4"></video>
      <button type="button" class="game-play" id="game-play">Press to play</button>
    </div>
    {JOURNEY.map((w, i) => (
      <div class="game-end" data-end={i} hidden>
        <p class="game-badge" hidden>Shipped</p>
        <p class="game-kicker">{stageCode(i) === 'Bonus' ? 'Bonus' : `World ${stageCode(i)}`} · {w.when}</p>
        <p class="game-case">{w.place}</p>
        <p class="game-meta">{w.line}</p>
        <p class="game-mission" hidden></p>
        {w.href && <a class="game-read" href={w.href}>Read the case →</a>}
        {i < JOURNEY.length - 1 ? (
          <div class="game-actions">
            <button type="button" class="game-play" data-next={i + 1}>{nextLabel(i)}</button>
            <button type="button" class="game-map" data-map>World map</button>
          </div>
        ) : (
          <>
            <ul class="game-links">
              <li><a href="https://apps.apple.com/app/id6765767262" target="_blank" rel="noopener">Winking Star<span class="vh"> (opens in new tab)</span> →</a></li>
              <li><a href="https://shannonhecker.github.io/fx-execution-analytics/" target="_blank" rel="noopener">FX execution analytics, rebuild<span class="vh"> (opens in new tab)</span> →</a></li>
              <li><a href="https://jpm-analytics-dashboard-shannon-h.vercel.app/" target="_blank" rel="noopener">Fusion analytics, rebuild<span class="vh"> (opens in new tab)</span> →</a></li>
            </ul>
            <div class="game-actions">
              <button type="button" class="game-play" data-next="0">Play again</button>
              <button type="button" class="game-map" data-map>World map</button>
            </div>
          </>
        )}
      </div>
    ))}
  </div>
  <div class="game-touch" aria-hidden="true">
    <button type="button" tabindex="-1" data-k="left">←</button>
    <button type="button" tabindex="-1" data-k="right">→</button>
    <button type="button" tabindex="-1" data-k="jump">↑</button>
  </div>
  <div class="game-bar">
    <label class="game-world">
      <span class="vh">Choose a world</span>
      <select id="game-world">
        {CHAPTERS.map((c, n) => (
          <optgroup label={'bonus' in c && c.bonus ? `Bonus · ${c.name}` : `World ${n + 1} · ${c.name}`}>
            {c.stages.map((i) => <option value={i}>{stageCode(i)} · {JOURNEY[i].place}</option>)}
          </optgroup>
        ))}
      </select>
    </label>
    <span class="game-tools">
      <button type="button" class="game-sound" id="game-full">Full screen</button>
      <button type="button" class="game-sound" id="game-sound" aria-pressed="false">Sound</button>
    </span>
  </div>
  <p class="game-caption">Working Order · from Kaohsiung to London to what's next</p>
  <p id="game-desc" class="vh">An optional pixel-art platformer that tells Shannon's career as a world map, in three worlds and a bonus: Taiwan (Kaohsiung, Ling Tung University, web design at 捷元電腦), London (London Met, J.P. Morgan, Barclays), Next: AI, and a bonus world for Winking Star. A world's stages play one after another. Each stage has a small enemy you can jump on and an optional mission for a gold star. Pressing Play opens it full screen; Escape or the Exit full screen button returns to the page. Arrow keys or WASD to move, Space or Up to jump, Escape to pause when not full screen. On the map, Left and Right choose a world and Space starts it.</p>
  <p id="game-status" class="vh" aria-live="polite"></p>
</div>
<script>
  // A four-second response to hover/focus, never a perpetual background loop.
  // No video bytes are requested on load, touch or under reduced motion.
  const poster = document.querySelector<HTMLElement>('.game-poster');
  const video = poster?.querySelector<HTMLVideoElement>('.game-cover-motion');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  const fine = matchMedia('(hover: hover)');
  if (poster && video) {
    let intent = 0;
    const stop = () => { intent++; video.pause(); video.classList.remove('is-visible'); };
    const preview = () => {
      if (reduce.matches || !fine.matches || document.hidden) return;
      const request = ++intent;
      if (!video.src) video.src = video.dataset.src!;
      video.currentTime = 0;
      void video.play().then(() => {
        if (request === intent) video.classList.add('is-visible');

      }).catch(() => { if (request === intent) stop(); });
    };
    poster.addEventListener('pointerenter', preview);
    poster.addEventListener('focusin', preview);
    poster.addEventListener('pointerleave', stop);
    poster.addEventListener('focusout', stop);
    poster.addEventListener('click', stop);
    video.addEventListener('ended', stop);
    reduce.addEventListener('change', stop);
    document.addEventListener('visibilitychange', () => { if (document.hidden) stop(); });
    new IntersectionObserver(([e]) => { if (!e.isIntersecting) stop(); }).observe(poster);
  }
</script>
