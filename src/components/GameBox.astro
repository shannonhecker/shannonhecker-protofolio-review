---
// The game lives in the hero, the way a playable Doodle sits on Google's home
// page: optional, idle until pressed, and the headline stays the main thing.
// It tells Shannon's career as a world map, Kaohsiung to AI. Every card states
// facts from her CV or her own words; nothing here is invented.
// DECISION: Named "Working Order" (a live order still filling; also "things in
// working order"). Mario-era pixel style, every noun from her own story.
import { ACHIEVEMENTS } from '../lib/achievements';
import { JOURNEY, stageCode, nextLabel } from '../lib/journey';
---
<div class="play" data-lenis-prevent>
  <button type="button" class="game-exit" id="game-exit" hidden><span class="game-exit-label">Exit full screen</span> <span aria-hidden="true">✕</span></button>
  <p class="game-rotate" aria-hidden="true">Turn your phone sideways for a bigger game</p>
  <div class="game" data-state="poster">
    <canvas id="game" width="480" height="270" tabindex="-1" role="application" aria-roledescription="game" aria-label="Working Order" aria-describedby="game-desc"></canvas>
    <div class="game-poster">
      <img src="/game/banner.webp" alt="" width="960" height="240" loading="lazy" decoding="async" />
      <button type="button" class="game-play" id="game-play">Press to play</button>
    </div>
    {JOURNEY.map((w, i) => (
      <div class="game-end" data-end={i} hidden>
        <div class="game-result-emblem" aria-hidden="true"><img src="/game/star.webp" alt="" width="48" height="48" loading="lazy" /><span>Stage clear</span></div>
        <p class="game-badge" hidden>Shipped</p>
        <p class="game-kicker">{stageCode(i) === 'Bonus' ? 'Bonus' : `World ${stageCode(i)}`} · {w.when}</p>
        <p class="game-case">{w.place}</p>
        <p class="game-meta">{w.line}</p>
        <p class="game-mission" hidden></p>
        <details class="career-achievements">
          <summary>Career achievements · {ACHIEVEMENTS[i].length} unlocked</summary>
          <ul>{ACHIEVEMENTS[i].map(reward=><li><strong>{reward.title}</strong><ul>{reward.projects.map(project=><li>{project}</li>)}</ul></li>)}</ul>
        </details>
        <section class="scoreboard" aria-label={`${w.place} scoreboard`}>
          <p class="score-total"><strong data-score>0</strong> points <span>this stage</span></p>
          <p class="score-rule">100 for finishing + 25 per pickup − 10 per bump. Minimum 100.</p>
          <details>
            <summary>Stage scoreboard · share your score</summary>
            <ol aria-label="Top ten scores"></ol>
            <form>
              <label for={`score-name-${i}`}>Nickname <span>(optional)</span></label>
              <input id={`score-name-${i}`} name="nickname" maxlength="20" autocomplete="off" placeholder="Explorer" aria-describedby={`score-note-${i}`} />
              <p id={`score-note-${i}`} class="score-note">Your nickname and score will be public. Use a made-up name.</p>
              <button type="submit">Share my score</button>
            </form>
            <p role="status"></p>
          </details>
        </section>
        {w.href && <a class="game-read" href={w.href}>Read the case →</a>}
        {i < JOURNEY.length - 1 ? (
          <div class="game-actions">
            <button type="button" class="game-play" data-next={i + 1}>{nextLabel(i)}</button>
            <button type="button" class="game-map" data-map>World map</button>
          </div>
        ) : (
          <>
            <ul class="game-links">
              <li><a href="https://apps.apple.com/app/id6765767262" target="_blank" rel="noopener">Winking Star<span class="vh"> (opens in new tab)</span> →</a></li>
              <li><a href="https://shannonhecker.github.io/fx-execution-analytics/" target="_blank" rel="noopener">FX execution analytics, rebuild<span class="vh"> (opens in new tab)</span> →</a></li>
              <li><a href="https://jpm-analytics-dashboard-shannon-h.vercel.app/" target="_blank" rel="noopener">Fusion analytics, rebuild<span class="vh"> (opens in new tab)</span> →</a></li>
            </ul>
            <div class="game-actions">
              <button type="button" class="game-play" data-next="0">Play again</button>
              <button type="button" class="game-map" data-map>World map</button>
            </div>
          </>
        )}
      </div>
    ))}
  </div>
  <div class="game-touch" aria-hidden="true">
    <button type="button" tabindex="-1" data-k="left">←</button>
    <button type="button" tabindex="-1" data-k="right">→</button>
    <button type="button" tabindex="-1" data-k="jump">↑</button>
  </div>
  <div class="game-bar">
    <button type="button" class="game-sound" id="game-world">World map</button>
    <span class="game-tools">
      <button type="button" class="game-sound" id="game-full">Full screen</button>
      <button type="button" class="game-sound" id="game-sound" aria-pressed="false">Sound</button>
    </span>
  </div>
  <nav class="game-stages" aria-label="Choose a stage" hidden>
    {JOURNEY.map((stage,i)=><button type="button" data-stage={i}><span>{stageCode(i)}</span>{stage.place}</button>)}
  </nav>
  <p class="game-caption">Working Order · from Kaohsiung to London to what's next</p>
  <p id="game-desc" class="vh">An optional pixel-art platformer that tells Shannon's career as a world map, in three worlds and a bonus: Taiwan (Kaohsiung, Ling Tung University, web design at 捷元電腦), London (London Met, J.P. Morgan, Barclays), Next: AI, and a bonus world for Winking Star. A world's stages play one after another. Collect a power star for eight seconds of extra speed and protection. Each stage has a small enemy you can jump on and an optional mission for a gold star. Pressing Play opens it full screen; Escape or the Exit full screen button returns to the page. Arrow keys or WASD to move, Space or Up to jump, Escape to pause when not full screen. On the map, Left and Right choose a world and Space starts it.</p>
  <p id="game-status" class="vh" aria-live="polite"></p>
</div>
