---
// The game is the portfolio's last chapter: one level per case, in the order
// the cases appear. Between levels a card hands the reader back to that case.
// DECISION: Named "Working Order" (a live order still filling; also "things in
// working order") instead of the brief's "Star Run", which sits close to
// Nintendo's Super Mario Run. Mario-era pixel style, every noun from the cases.
import Pic from './Pic.astro';
import { CASES } from '../lib/cases';
const LEVELS = [
  { name: 'The Desk', case: CASES[0] },
  { name: 'The Board Room', case: CASES[1] },
  { name: 'Bedtime', case: CASES[2] },
];
---
<section id="play" class="band play" aria-labelledby="play-title">
  <div class="wrap">
    <div class="g" style="row-gap:24px;margin-bottom:clamp(32px,4vw,56px)">
      <p class="eyebrow" style="grid-column:1/4">Play</p>
      <h2 id="play-title" class="h-section" style="grid-column:4/12">Working Order</h2>
    </div>
    <div class="game-bar">
      <a class="skip-game" href="#links">Skip to links</a>
      <div class="game-levels" role="group" aria-label="Choose a level">
        {LEVELS.map((l, i) => (
          <button type="button" class="game-level" data-level={i} aria-pressed={i === 0 ? 'true' : 'false'}>
            <span class="n">{i + 1}</span>{l.name}
          </button>
        ))}
      </div>
      <button type="button" class="game-sound" id="game-sound" aria-pressed="false">Sound</button>
    </div>
    <div class="game" data-state="poster">
      <canvas id="game" width="480" height="270" tabindex="-1" role="application" aria-roledescription="game" aria-label="Working Order" aria-describedby="game-desc"></canvas>
      <div class="game-poster">
        <Pic name="game-poster.png" alt="" sizes="(max-width: 1100px) 100vw, 1100px" widths={[640, 960, 1440, 1920]} />
        <button type="button" class="game-play" id="game-play">Press to play</button>
      </div>
      {LEVELS.map((l, i) => (
        <div class="game-end" data-end={i} hidden>
          <p class="game-badge" hidden>Shipped</p>
          <p class="game-kicker">Level {i + 1} · {l.name}</p>
          <p class="game-case">{l.case.title}</p>
          <p class="game-meta">{l.case.meta}</p>
          <a class="game-read" href={l.case.href}>Read the case →</a>
          {i < LEVELS.length - 1 ? (
            <button type="button" class="game-play" data-next={i + 1}>Next level</button>
          ) : (
            <>
              <ul class="game-links">
                <li><a href="https://apps.apple.com/app/id6765767262" target="_blank" rel="noopener">Winking Star<span class="vh"> (opens in new tab)</span> →</a></li>
                <li><a href="https://shannonhecker.github.io/fx-execution-analytics/" target="_blank" rel="noopener">FX execution analytics, rebuild<span class="vh"> (opens in new tab)</span> →</a></li>
                <li><a href="https://jpm-analytics-dashboard-shannon-h.vercel.app/" target="_blank" rel="noopener">Fusion analytics, rebuild<span class="vh"> (opens in new tab)</span> →</a></li>
              </ul>
              <button type="button" class="game-play" data-next="0">Play again</button>
            </>
          )}
        </div>
      ))}
    </div>
    <div class="game-touch" aria-hidden="true">
      <button type="button" tabindex="-1" data-k="left">←</button>
      <button type="button" tabindex="-1" data-k="right">→</button>
      <button type="button" tabindex="-1" data-k="jump">↑</button>
    </div>
    <p id="game-desc" class="vh">A pixel-art platformer in three short levels, one for each case: The Desk for FX execution analytics, The Board Room for the Fusion dashboard, and Bedtime for Winking Star. Arrow keys or WASD to move, Space or Up to jump, Escape to pause. Collect everything in a level to earn its Shipped badge. Playing is optional; everything on this site is readable without it.</p>
    <p id="game-status" class="vh" aria-live="polite"></p>
  </div>
</section>
