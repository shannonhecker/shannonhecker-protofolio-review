---
import { Picture } from 'astro:assets';
import reprice from '../assets/img/fx-figma/reprice.png';
import ticket from '../assets/img/fx-figma/staged-ticket.png';
const screens=[{image:reprice,node:'8-2746',label:'Drag-to-reprice',alt:'My Figma interaction design showing the dragged limit-price line and the order-amended confirmation, with simulated data.'},{image:ticket,node:'74-7013',label:'Pill release to order ticket',alt:'My Figma interaction design showing a pre-filled limit-order ticket opened from a chart price pill, with simulated data.'}];
---
<div class="screen-sequence fx-design-evidence">
 {screens.map(screen=><figure class="product-capture"><div class="shot evidence"><Picture src={screen.image} widths={[640,960,1265]} sizes="90vw" formats={['avif','webp']} alt={screen.alt} loading="lazy" decoding="async" /></div><figcaption><span>My Figma design · {screen.label} · Simulated data</span><a href={screen.image.src} target="_blank" rel="noopener">View full size<span class="vh">: {screen.label} (opens in new tab)</span></a><a href={`https://www.figma.com/design/uCUV8a6hZVWo54ko5GrjvJ?node-id=${screen.node}`} target="_blank" rel="noopener">View Figma source<span class="vh"> (opens in new tab)</span> ↗</a></figcaption></figure>)}
</div>
