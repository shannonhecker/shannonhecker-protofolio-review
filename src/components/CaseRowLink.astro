---
import Pic from './Pic.astro';
import HomeProjectArtwork from './HomeProjectArtwork.astro';
import type { CaseRow } from '../lib/cases';
interface Props { c: CaseRow; homeArtwork?: boolean }
const { c, homeArtwork=false } = Astro.props;
---
<a class="row" href={c.href} data-cursor="big" data-chapter={c.vt}>
  <span class="n">{c.n}</span>
  <h3>{c.title}<span class="arrow" aria-hidden="true">→</span></h3>
  <span class="meta">{c.meta}</span>
  {homeArtwork ? <HomeProjectArtwork project={c.vt} /> : c.vt==='winking' ? <div class="project-preview appstore-preview">
    {['home','activity','treasure','progress'].map(screen=><Pic name={`appstore-iphone-${screen}.jpg`} alt={`Winking Star App Store screenshot: ${screen}`} sizes="(max-width:760px) 21vw, 10vw" widths={[240,480]} />)}
  </div> : c.img && <Pic name={c.img} alt="" sizes="(max-width: 760px) 90vw, 44vw" widths={[480,800,1200,1600]} />}
</a>
