---
import Pic from './Pic.astro';
import BrandMark from './BrandMark.astro';
import type { CaseRow } from '../lib/cases';
interface Props { c: CaseRow }
const { c } = Astro.props;
---
<a class="row" href={c.href} data-cursor="big">
  <span class="n">{c.n}</span>
  <h3 style={`view-transition-name:t-${c.vt}`}>{c.title}{(c.href==='/uoaui'||c.href==='/winking-star')&&<BrandMark project={c.href==='/uoaui'?'ai':'winking'} compact />}</h3>
  <span class="meta">{c.meta}</span>
  <span class="arrow">{c.arrow}</span>
  {c.img && <Pic name={c.img} alt="" sizes="(max-width: 760px) 90vw, 28vw" widths={[480, 800]} />}
</a>
