---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/img/figma-sync/*.png', { eager: true });
interface Props { name: string; alt: string; eager?: boolean; sizes?: string; link?: boolean }
const { name, alt, eager=false, sizes='(max-width:760px) 90vw, 70vw', link=true } = Astro.props;
const source = images[`../assets/img/figma-sync/${name}`]?.default;
if (!source) throw new Error(`Missing authored image: ${name}`);
const widths = [...new Set([640,1280,2200].map(w=>Math.min(w,source.width)))];
---
{link ? <a class="authored-image-link" href={source.src} target="_blank" rel="noopener" aria-label={`View full size: ${alt} (opens in new tab)`}>
  <Picture src={source} alt={alt} formats={['webp']} widths={widths} sizes={sizes} quality={90} loading={eager?'eager':'lazy'} decoding="async" fetchpriority={eager?'high':undefined} />
</a> : <Picture src={source} alt={alt} formats={['webp']} widths={widths} sizes={sizes} quality={90} loading={eager?'eager':'lazy'} decoding="async" />}
<style>
 .authored-image-link{display:block;max-width:100%;border-radius:var(--radius);outline-offset:6px}
 :global(.authored-image-link img){display:block;width:100%;height:auto;border-radius:var(--radius)}
</style>
