---
import { decisions, type Project } from '../../lib/process';
import DecisionFlow from './DecisionFlow.astro';
import Schematic from './Schematic.astro';
interface Props { project: Project }
const { project } = Astro.props;
const sketches={fx:[['dual','split'],['ticket','menu'],['studies','gaps']],fusion:[['widgets','fixed'],['two','three'],['shared','fork']],ai:[['components','freeform'],['systems','fixed'],['tune','prompt']],winking:[['star','checklist'],['sample','empty'],['unlock','subscription']]};
---
<section class="decision-map" aria-labelledby={`${project}-decision-map-title`} id={`${project}-decision-map`}>
  <header class="process-heading"><h3 id={`${project}-decision-map-title`}>Decision map</h3><p>I have pulled the choices and trade-offs below into one view.</p></header>
  <slot name="flow"><DecisionFlow project={project} /></slot>
  <ol class="visual-decisions">{decisions[project].map((d,i) => <li>
    <div class="choice-origin"><span aria-hidden="true">{String(i+1).padStart(2,'0')}</span><h4>{d.question}</h4></div>
    <div class="choice-fork">
      <div class="choice-path selected"><div class="choice-status"><span aria-hidden="true">✓</span> I chose</div><Schematic kind={sketches[project][i][0]} /><p>{d.chosen}</p></div>
      <div class="choice-path alternative"><div class="choice-status"><span aria-hidden="true">↗</span> Alternative</div><Schematic kind={sketches[project][i][1]} /><p>{d.alternative}</p></div>
    </div>
    <p class="choice-consequence">{d.reason}</p>
  </li>)}</ol>
</section>
<style>
.decision-map>.visual-decisions{display:grid;grid-template-columns:1fr;gap:80px;list-style:none;padding:0;margin-top:64px}.decision-map>.visual-decisions>li{display:grid;grid-template-columns:minmax(140px,.65fr) minmax(0,2fr) minmax(190px,1fr);gap:36px;align-items:center;border:0;padding:0}.choice-origin{position:relative;display:flex;gap:20px;align-items:center}.choice-origin>span{flex:none;display:grid;place-items:center;width:38px;height:38px;position:relative;font-size:13px;color:var(--project-ink)}.choice-origin>span:before{content:'';position:absolute;inset:3px;border:1px solid var(--project-ink);transform:rotate(45deg)}.choice-origin h4{font-size:22px;line-height:1.4;margin:0}.choice-fork{position:relative;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px;padding:32px 0}.choice-fork:before{content:'';position:absolute;left:-25px;top:50%;width:25px;border-top:1px solid var(--project-ink)}.choice-fork:after{content:'';position:absolute;left:0;right:0;top:0;height:20px;border-top:1px solid var(--project-ink);border-left:1px solid var(--project-ink);border-right:1px dashed var(--fg-2)}.choice-path{position:relative;min-width:0;padding:20px;background:var(--project-wash);border-bottom:2px solid var(--project-ink)}.choice-path.alternative{background:transparent;border:1px dashed var(--hair)}.choice-status{font-size:13px;font-weight:600;display:flex;gap:8px;align-items:center;margin-bottom:24px;color:var(--fg-2)}.choice-path p{font-size:17px;line-height:1.5;margin:20px 0 0}.choice-consequence{position:relative;font-size:17px;line-height:1.75;margin:0;padding:24px 0 24px 24px;border-left:2px solid var(--project-ink)}.choice-consequence:before{content:'';position:absolute;left:-37px;top:50%;width:35px;border-top:1px solid var(--project-ink)}
@media(max-width:1100px){.decision-map>.visual-decisions>li{grid-template-columns:minmax(0,.55fr) minmax(0,1.5fr)}.choice-consequence{grid-column:2}.choice-consequence:before{display:none}}
@media(max-width:640px){.decision-map>.visual-decisions{gap:56px;margin-top:40px}.decision-map>.visual-decisions>li{display:block}.choice-origin{margin-bottom:32px;gap:16px}.choice-origin:after{content:'';position:absolute;left:19px;bottom:-32px;height:25px;border-left:1px solid var(--project-ink)}.choice-fork{gap:14px;padding:20px 0}.choice-fork:before{display:none}.choice-path{padding:12px}.choice-status{margin-bottom:20px}.choice-path p{font-size:15px;line-height:1.55}.choice-consequence{font-size:16px;margin-top:8px;padding:12px 0 12px 18px}.choice-origin h4{font-size:22px}}
</style>
