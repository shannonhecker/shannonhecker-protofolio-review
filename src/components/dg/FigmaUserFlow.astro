---
import maps from '../../data/figma-user-flows.json';
import content from '../../data/user-flow-content.json';
import FlatArrow from '../FlatArrow.astro';
interface Props { project: keyof typeof content }
const {project}=Astro.props;
const graph=content[project];
const dark=maps.maps.find(m=>m.key===project&&m.theme==='dark')!;
const source=`https://www.figma.com/design/${maps.fileKey}?node-id=${dark.nodeId.replace(':','-')}`;
---
<figure class="figma-user-flow" aria-labelledby={`${project}-user-flow-title`}>
 <figcaption><h4 id={`${project}-user-flow-title`}>User flow</h4><p>{graph.subtitle}</p><p class="flow-scope">{graph.scope}</p></figcaption>
 <div class="flow-tools"><p>Follow the central path. Scroll sideways to explore the branches.</p><a href={source} target="_blank" rel="noopener">View in Figma <FlatArrow /></a></div>
 <div class="user-flow-scroll" tabindex="0" role="region" aria-label={`${graph.title}. Scroll horizontally to explore the user flow.`}>
  {(['light','dark'] as const).map(theme=><a class={`flow-image flow-${theme}`} href={`/art/user-flows/${project}-${theme}.svg`} target="_blank" rel="noopener" aria-label={`Open the full-size ${graph.title} user flow`}><img src={`/art/user-flows/${project}-${theme}.svg`} width={graph.width} height={graph.height} loading="lazy" decoding="async" alt={`${graph.title}. ${graph.subtitle} A complete text version follows.`}/></a>)}
 </div>
 <details class="user-flow-transcript"><summary>Read the user flow as text</summary>
  <ol>{graph.nodes.map(n=><li><strong>{n.title}.</strong> {n.actor}. {n.body}</li>)}</ol>
  <h5>Actions, branches and returns</h5>
  <ul>{graph.edges.map(e=><li>{graph.nodes.find(n=>n.id===e.source)?.title} → {graph.nodes.find(n=>n.id===e.target)?.title}{e.label?` (${e.label.replace(/\n/g,' ')})`:''}.</li>)}</ul>
 </details>
 {Astro.slots.has('default') && <details class="original-flow-summary"><summary>Original workflow summary</summary><slot /></details>}
</figure>
<style>
.figma-user-flow{margin:36px 0 56px;min-width:0}
figcaption{margin:0 0 24px}h4{font-size:24px;line-height:1.3;font-weight:500;margin:0 0 12px}figcaption p{font-size:16px;line-height:1.65;max-width:70ch;color:var(--fg-2);margin:0}figcaption .flow-scope{font-size:13px;margin-top:12px}
.flow-tools{display:flex;gap:20px;justify-content:space-between;align-items:baseline;margin-bottom:16px;font-size:13px;line-height:1.5}.flow-tools p{margin:0;color:var(--fg-2)}.flow-tools a{white-space:nowrap;display:inline-flex;align-items:center;gap:6px}
.user-flow-scroll{overflow-x:auto;overscroll-behavior-x:contain;border:1px solid var(--divider);border-radius:var(--radius)}.user-flow-scroll:focus-visible{outline:2px solid var(--project-ink);outline-offset:4px}
.flow-image{display:block;width:100%}.flow-image img{display:block;width:100%;height:auto;max-height:none;object-fit:contain}.flow-dark{display:none}:global(html[data-theme="dark"]) .flow-light{display:none}:global(html[data-theme="dark"]) .flow-dark{display:block}
.user-flow-transcript,.original-flow-summary{margin-top:18px;font-size:15px;line-height:1.7;color:var(--fg-2)}summary{cursor:pointer;color:var(--fg)}.user-flow-transcript ul,.user-flow-transcript ol{padding-left:20px}.user-flow-transcript li{margin-block:8px}.user-flow-transcript h5{font-size:15px;margin-top:24px}
@media(max-width:760px){.flow-image{min-width:1120px}.flow-tools{align-items:flex-start;flex-direction:column;gap:8px}.figma-user-flow{margin-block:28px 40px}}
</style>
<script>
 const narrow=window.matchMedia('(max-width:760px)');
 const regions=document.querySelectorAll<HTMLElement>('.user-flow-scroll');
 const positionFlows=()=>regions.forEach(region=>{region.scrollLeft=narrow.matches?(region.scrollWidth-region.clientWidth)/2:0;});
 regions.forEach(region=>region.addEventListener('keydown',event=>{
  if(event.target!==region||event.altKey||event.ctrlKey||event.metaKey||event.shiftKey)return;
  if(event.key!=='ArrowLeft'&&event.key!=='ArrowRight')return;
  event.preventDefault();region.scrollBy({left:event.key==='ArrowRight'?80:-80,behavior:'instant'});
 }));
 requestAnimationFrame(positionFlows);narrow.addEventListener('change',positionFlows);
</script>
