---
import content from '../../data/authored-content.json';
import AuthoredImage from '../AuthoredImage.astro';
interface Props { project: keyof typeof content; id?: string }
const {project,id=`${Astro.props.project}-personas`}=Astro.props;
const data=content[project].personas;
---
<section class="authored-personas" id={id} aria-labelledby={`${id}-title`}>
 <header class="process-heading"><h3 id={`${id}-title`}>User personas</h3><p>{data.intro}</p></header>
 <div class="authored-persona-list">{data.items.map(p=><article class:list={['authored-persona',{'has-art':!!p.image}]}>
  <div class="authored-persona-identity">
   <div class="persona-copy"><h4>{p.name}</h4><p class="persona-role">{p.role}</p><p class="persona-quote">{p.quote}</p></div>
   {p.image && <div class="persona-art"><AuthoredImage name={p.image} alt="" sizes="(max-width:760px) 40vw, 23vw" link={false}/></div>}
  </div>
  <div class="authored-persona-needs">{p.groups.map(g=><div><h5>{g.label}</h5><ul>{g.items.map(t=><li>{t}</li>)}</ul></div>)}</div>
 </article>)}</div>
 <p class="art-note">{data.note}</p>
</section>
<style>
.authored-personas{min-width:0;margin-block:48px 80px;scroll-margin-top:140px}.authored-persona-list{display:grid;gap:56px;margin-top:40px}.authored-persona{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:clamp(28px,4vw,64px);align-items:start}.authored-persona-identity{position:relative;display:grid;grid-template-columns:minmax(0,1fr);background:var(--project-wash);border-radius:var(--radius);padding:clamp(24px,3vw,40px);min-height:320px;overflow:hidden}.has-art .authored-persona-identity{grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);min-height:420px;padding-bottom:0}.persona-copy{position:relative;z-index:1;padding-bottom:32px}.persona-copy h4{font-size:clamp(26px,2.35vw,36px);line-height:1.14;letter-spacing:-.035em;margin:0 0 18px;overflow-wrap:normal}.persona-role{font-size:15px;line-height:1.6;white-space:pre-line;color:var(--fg)}.persona-quote{margin-top:28px;padding-top:20px;border-top:2px solid var(--project-ink);font-size:15px;line-height:1.6;font-style:italic;color:var(--fg-2)}.persona-art{align-self:end;margin-left:-12px;margin-right:-28px;pointer-events:none}.persona-art :global(img){display:block;width:100%;height:auto;max-height:460px;object-fit:contain;object-position:bottom}.authored-persona-needs{display:grid;gap:28px;padding-top:4px}.authored-persona-needs h5{font-size:clamp(18px,1.8vw,25px);margin:0 0 12px}.authored-persona-needs ul{list-style:disc;padding-left:1.15em;display:grid;gap:8px;color:var(--fg-2);font-size:clamp(16px,1.35vw,20px);line-height:1.6}.art-note{margin-top:28px;color:var(--fg-2);font-size:13px;line-height:1.6}
@media(max-width:850px){.authored-persona{grid-template-columns:1fr;gap:28px}.authored-persona-identity{min-height:0}.has-art .authored-persona-identity{min-height:300px;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr)}.persona-art :global(img){max-height:340px}.authored-persona-list{gap:64px}.authored-persona-needs{gap:24px}.authored-personas{margin-bottom:48px}.persona-copy h4{font-size:30px}}
</style>
