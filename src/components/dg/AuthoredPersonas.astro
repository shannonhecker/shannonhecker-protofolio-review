---
import content from '../../data/authored-content.json';
import PersonaCard from './PersonaCard.astro';
interface Props { project: keyof typeof content; id?: string }
const {project,id=`${Astro.props.project}-personas`}=Astro.props;
const data=content[project].personas;
---
<section class="authored-personas" id={id} aria-labelledby={`${id}-title`}>
 <header class="process-heading"><h3 id={`${id}-title`}>User personas</h3><p>{data.intro}</p></header>
 <div class="authored-persona-list">{data.items.map((p,index)=><PersonaCard name={p.name} role={p.role} quote={p.quote} portrait={`${project}-${index}`} groups={p.groups} background={project==='fx'?['#f5e4dc','#f3f3f3','#e7eeff'][index]:project==='ai'?['#eff0e3','#f1f5f9'][index]:undefined}/>)}</div>
 <p class="art-note">{data.note}</p>
</section>
<style>
.authored-personas{min-width:0;margin-block:48px 80px;scroll-margin-top:140px}.authored-persona-list{display:grid;gap:48px;margin-top:40px}.art-note{margin-top:28px;color:var(--fg-2);font-size:13px;line-height:1.6}
@media(max-width:850px){.authored-persona-list{gap:40px}.authored-personas{margin-bottom:48px}}
</style>
