---
import content from '../../data/authored-content.json';
import AuthoredImage from '../AuthoredImage.astro';
interface Props { project: keyof typeof content; id?: string }
const {project,id=`${Astro.props.project}-journey`}=Astro.props;
const data=content[project].journey;
---
<section id={id} class="authored-journey" aria-labelledby={`${id}-title`}>
 <header class="process-heading"><h3 id={`${id}-title`}>User journey</h3><p>{data.line}</p></header>
 <div class="experience-context"><div><h4>Persona</h4><p>{data.persona}</p></div><div><h4>Scenario</h4><p>{data.scenario}</p></div><div><h4>Goal</h4><p>{data.goal}</p></div></div>
 <figure class="experience-figure"><div class="experience-scroll" tabindex="0" role="region" aria-label="Thoughts and feelings map, scroll horizontally to explore"><AuthoredImage name={data.plot} alt={`Qualitative thoughts, feelings, effort and tool switching across ${data.persona}'s journey`} sizes="(max-width:1100px) 1100px, 90vw"/></div><figcaption>My qualitative experience map. Scroll the diagram on a smaller screen, or open it full size.</figcaption></figure>
 <details class="experience-transcript"><summary>Read the thoughts and turning points</summary><ol>{data.quotes.map(q=><li>{q}</li>)}</ol></details>
 <div class="experience-approach"><h4>Approach</h4><ul>{data.approachText.map(t=><li>{t}</li>)}</ul></div>
 <div class="experience-phases">{data.phases.map(p=><div><h4>{p.title}</h4><p>{p.description}</p></div>)}</div>
 <ol class="experience-steps">{data.steps.map((s,i)=><li><h4><span>{String(i+1).padStart(2,'0')}</span>{s.title}</h4><p>{s.description}</p><h5>Recommendation</h5><ul>{s.recommendations.map(r=><li>{r}</li>)}</ul><div class="experience-backstage"><h5>What the system does</h5><p>{s.backstage}</p></div></li>)}</ol>
 <div class="experience-takeaways">{data.takeaways.map(t=><div><h4>{t.label}</h4><p>{t.text}</p></div>)}</div>
</section>
<style>
.authored-journey{min-width:0;margin-block:64px 96px;scroll-margin-top:140px}.experience-context{display:grid;grid-template-columns:.65fr 1.3fr 1fr;gap:40px;margin-block:40px}.experience-context h4{font-size:13px;letter-spacing:.04em;text-transform:uppercase;color:var(--project-ink);padding-bottom:14px;border-bottom:1px solid var(--divider);margin-bottom:16px}.experience-context p,.experience-steps p,.experience-steps li li,.experience-takeaways p{font-size:16px;line-height:1.7;color:var(--fg-2)}.experience-figure{margin:0}.experience-scroll{overflow-x:auto;overscroll-behavior-x:contain;border-radius:var(--radius)}.experience-scroll :global(.authored-image-link){min-width:1100px}.experience-figure figcaption{font-size:13px;color:var(--fg-2);margin-top:12px;line-height:1.6}.experience-transcript{margin-top:20px;font-size:15px;color:var(--fg-2)}.experience-transcript summary{cursor:pointer;min-height:44px;padding-block:12px;color:var(--fg)}.experience-transcript ol{padding:20px 24px;display:grid;gap:10px;list-style:decimal}.experience-approach{display:grid;grid-template-columns:150px 1fr;gap:24px;padding-block:28px;margin-top:24px;border-block:1px solid var(--divider)}.experience-approach h4{font-size:16px}.experience-approach ul{display:flex;gap:16px;flex-wrap:wrap;list-style:none;padding:0}.experience-approach li{padding-left:16px;border-left:2px solid var(--project-ink);font-size:15px;line-height:1.6}.experience-phases{display:flex;gap:24px;margin-block:48px 32px}.experience-phases>div{flex:1;padding:16px 0;border-top:2px solid var(--project-ink)}.experience-phases h4{font-size:18px}.experience-phases p{font-size:14px;margin-top:6px;color:var(--fg-2)}.experience-steps{list-style:none;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:48px 36px}.experience-steps>li{min-width:0;padding-top:18px;border-top:1px solid var(--divider)}.experience-steps h4{font-size:22px;letter-spacing:-.02em;line-height:1.3;margin-bottom:20px}.experience-steps h4 span{display:block;font-size:13px;color:var(--project-ink);margin-bottom:12px}.experience-steps h5{font-size:14px;margin:24px 0 12px}.experience-steps ul{list-style:disc;padding-left:18px;display:grid;gap:8px}.experience-backstage{border-top:1px dashed var(--hair);margin-top:28px}.experience-takeaways{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:36px 48px;margin-top:56px;padding-top:40px;border-top:1px solid var(--divider)}.experience-takeaways h4{font-size:16px;margin-bottom:14px;color:var(--project-ink)}
@media(max-width:950px){.experience-context{grid-template-columns:1fr;gap:24px}.experience-steps{grid-template-columns:repeat(2,minmax(0,1fr))}.experience-approach{grid-template-columns:1fr}}
@media(max-width:600px){.authored-journey{margin-block:40px 56px}.experience-steps,.experience-takeaways{grid-template-columns:1fr;gap:36px}.experience-phases{display:grid;gap:12px}.experience-approach ul{display:grid;gap:16px}.experience-takeaways{margin-top:40px}}
</style>
