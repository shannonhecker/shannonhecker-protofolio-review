---
import content from '../../data/authored-content.json';

import { Image } from 'astro:assets';
const portraits=import.meta.glob<{default:import('astro').ImageMetadata}>('../../assets/img/personas/*.png',{eager:true});
interface Props { project: keyof typeof content; id?: string }
const {project,id=`${Astro.props.project}-journey`}=Astro.props;
const data=content[project].journey;
const persona=content[project].personas.items.find(p=>p.name===data.persona) ?? content[project].personas.items[0];
const portraitIndex=content[project].personas.items.findIndex(p=>p.name===persona.name);
const portrait=portraits[`../../assets/img/personas/${project}-${portraitIndex}.png`].default;
const groups:Record<string,number[]>={fusion:[3,2],ai:[2,2,1],winking:[4,2],deal:[3,2]};
const counts=groups[project] ?? [data.steps.length];
---
<section id={id} class="authored-journey" aria-labelledby={`${id}-title`}>
 <header class="process-heading"><h3 id={`${id}-title`}>User journey</h3><p>{data.line}</p></header>
 <div class="experience-context"><div><h4>Persona</h4><div class="experience-identity"><Image src={portrait} width={64} height={64} alt=""/><div><strong>{data.persona}</strong><p>{persona.role}</p></div></div></div><div><h4>Scenario</h4><p>{data.scenario}</p></div><div><h4>Goal</h4><p>{data.goal}</p></div></div>
 <div class="experience-scroll" tabindex="0" role="region" aria-label="Original thoughts, feelings and approach graphics. Scroll horizontally to explore on smaller screens."><div class="experience-artwork"><img src={`/art/${project}-experience.svg`} width={985} height={project === "winking" ? 470 : 357} loading="lazy" alt={`Qualitative thoughts, feelings, effort and tool switching across ${data.persona}'s journey`}/><img src={`/art/${project}-approach.svg`} width={project === "winking" ? 873 : 872} height={project === "winking" ? 112 : 84} loading="lazy" alt={data.approachText.join('. ')}/></div></div>
 <section class="experience-transcript"><h4>Thoughts and turning points</h4><ol>{data.quotes.map(q=><li>{q}</li>)}</ol></section>
 <section class="experience-phases"><h4>Journey phases</h4>{data.phases.map((phase,pi)=>{const start=counts.slice(0,pi).reduce((a,b)=>a+b,0);return <section class="experience-phase"><header><h5>{phase.title}</h5><p>{phase.description}</p></header><ol class="experience-steps" start={start+1}>{data.steps.slice(start,start+counts[pi]).map((s,i)=><li><h6><span>{String(start+i+1).padStart(2,'0')}</span>{s.title}</h6><p>{s.description}</p><strong class="recommendation-label">Recommendation</strong><ul>{s.recommendations.map(r=><li>{r}</li>)}</ul><div class="experience-backstage"><strong class="recommendation-label">What the system does</strong><p>{s.backstage}</p></div></li>)}</ol></section>})}</section>
 <div class="experience-takeaways">{data.takeaways.map(t=><div><h4>{t.label}</h4><p>{t.text}</p></div>)}</div>
</section>
<style>
.authored-journey{min-width:0;margin-block:64px 96px;scroll-margin-top:140px}
.experience-context{display:grid;grid-template-columns:1fr 1.4fr 1fr;gap:32px;margin-block:36px 48px}
.experience-context h4{font-size:14px;line-height:1.5;color:var(--project-ink);border-top:1px solid var(--divider);padding-top:14px;margin:0 0 20px}
.experience-context p,.experience-steps p,.experience-steps ul,.experience-takeaways p{font-size:16px;line-height:1.7;color:var(--fg-2);margin:0;white-space:pre-line}
.experience-identity{display:flex;align-items:center;gap:14px}.experience-identity img{width:56px;height:56px;object-fit:cover;object-position:center 20%;border-radius:50%}.experience-identity strong{font-size:18px}.experience-identity p{margin-top:4px}
.experience-scroll{overflow-x:auto;overscroll-behavior-x:contain;margin-block:32px 48px}.experience-artwork{display:grid;gap:24px}.experience-artwork :global(img){display:block;width:100%;height:auto}
.experience-transcript{font-size:16px;line-height:1.7;color:var(--fg-2);margin-block:32px 48px}.experience-transcript h4{font-size:18px;color:var(--fg)}.experience-transcript ol{padding-left:24px;display:grid;grid-template-columns:1fr 1fr;gap:12px 32px}
.experience-phases>h4{font-size:22px;margin:0 0 24px}.experience-phase{margin-top:32px}.experience-phase>header{border-left:4px solid var(--project-ink);padding-left:18px;margin-bottom:28px}.experience-phase h5{font-size:20px;line-height:1.4;margin:0 0 6px}.experience-phase header p{font-size:16px;line-height:1.6;color:var(--fg-2)}
.experience-steps{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:36px 32px;list-style:none;padding:0;margin:0}.experience-steps>li{border-top:3px solid var(--project-ink);padding-top:18px;min-width:0}.experience-steps h6{font-size:20px;line-height:1.4;margin:0 0 16px}.experience-steps h6 span{display:block;font-size:13px;color:var(--fg-2);margin-bottom:8px}.recommendation-label{display:block;font-size:14px;margin:22px 0 10px}.experience-steps ul{padding-left:20px;list-style:disc}.experience-steps ul li+li{margin-top:6px}.experience-backstage{border-top:1px dashed var(--hair);margin-top:28px}
.experience-takeaways{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:36px 32px;margin-top:48px;padding-top:32px;border-top:1px solid var(--divider)}.experience-takeaways h4{font-size:16px;margin-bottom:14px;color:var(--project-ink)}
@media(max-width:1000px){.experience-context{grid-template-columns:1fr;gap:28px}}
@media(max-width:760px){.experience-artwork{min-width:1100px}}
@media(max-width:600px){.authored-journey{margin-block:40px 56px}.experience-steps,.experience-takeaways,.experience-transcript ol{grid-template-columns:1fr}.experience-context{margin-block:28px 36px}}
</style>
