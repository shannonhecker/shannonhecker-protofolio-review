---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
 name:string; role:string; quote:string; portrait:string;
 groups:{label:string;items:string[]}[];
 kind?:'fx'|'authored';
 background?:string;
}
const {name,role,quote,portrait,groups,kind='authored',background='#f5e4dc'}=Astro.props;
const images=import.meta.glob<{default:ImageMetadata}>('../../assets/img/personas/*.png',{eager:true});
const source=images[`../../assets/img/personas/${portrait}.png`]?.default;
if(!source)throw new Error(`Missing persona portrait: ${portrait}`);
---
<article style={`--persona-background:${background}`} class:list={['persona-card',kind==='fx'?'fx-persona':'authored-persona']}>
 <div class="persona-identity">
  <div class="persona-copy"><h4>{name}</h4><p class="persona-role">{role}</p><blockquote>{quote}</blockquote></div>
  <div class="persona-art"><Picture src={source} alt="" formats={['webp']} widths={[300,600,900]} sizes="(max-width:420px) 75vw, 300px" quality={90} loading="lazy" decoding="async"/></div>
 </div>
 <div class="authored-persona-needs">{groups.map(group=><div><h5>{group.label}</h5><ul>{group.items.map(item=><li>{item}</li>)}</ul></div>)}</div>
</article>
<style>
.persona-card{--fg:#272b32;--fg-2:#514b49;display:grid;grid-template-columns:minmax(0,0.9fr) minmax(0,1.3fr);background:var(--persona-background);color:var(--fg);border-radius:4px;overflow:hidden;isolation:isolate;font-family:var(--body)}
.persona-card .persona-identity{min-width:0;min-height:0;display:flex;flex-direction:column;align-items:center;gap:0;margin:0;padding:32px 28px 0}
.persona-copy{width:100%;padding:0 0 24px}
.persona-card .persona-copy h4{color:var(--fg);font:500 28px/1.15 var(--display);letter-spacing:-.025em;margin:0 0 10px}
.persona-card .persona-role{font-size:14px;line-height:1.5;white-space:pre-line;color:var(--fg-2);margin:0;max-width:32ch}
.persona-card blockquote{margin:20px 0 0;font-size:16px;line-height:1.5;letter-spacing:-.01em;max-width:30ch}
.persona-card .persona-art{width:min(100%,240px);aspect-ratio:3/4;margin:auto 0 0;mix-blend-mode:darken}
.persona-art :global(img){display:block;width:100%;height:100%;object-fit:contain;border-radius:0}
.authored-persona-needs{display:grid;align-content:start;gap:24px;padding:34px 32px 32px 12px}
.authored-persona-needs h5{font:600 16px/1.35 var(--body);letter-spacing:-.01em;margin:0 0 8px;color:var(--fg)}
.authored-persona-needs ul{list-style:disc;padding-left:1.1em;margin:0;display:grid;gap:4px;color:var(--fg-2);font-size:16px;line-height:1.5;max-width:48ch}
.authored-persona-needs li{padding-left:2px}
@media(max-width:850px){.persona-card{grid-template-columns:1fr}.persona-card .persona-identity{display:grid;grid-template-columns:minmax(0,1fr) 140px;align-items:end;gap:16px;padding:28px 24px 0}.persona-copy{align-self:start;padding:0 0 24px}.persona-card .persona-copy h4{font-size:26px}.persona-card blockquote{margin-top:16px}.persona-card .persona-art{width:140px;margin:0}.authored-persona-needs{padding:24px;gap:24px;border-top:1px solid #272b321a}}
@media(max-width:480px){.persona-card .persona-identity{grid-template-columns:minmax(0,1fr) 100px;gap:12px;padding:24px 20px 0}.persona-card .persona-art{width:100px}.persona-card .persona-copy h4{font-size:24px}.persona-card .persona-role{font-size:13px}.persona-card blockquote{font-size:15px}.authored-persona-needs{padding:24px 20px}.authored-persona-needs ul{font-size:15px;line-height:1.55}}
</style>
