---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
 name:string; role:string; quote:string; portrait:string;
 groups:{label:string;items:string[]}[];
 kind?:'fx'|'authored';
}
const {name,role,quote,portrait,groups,kind='authored'}=Astro.props;
const images=import.meta.glob<{default:ImageMetadata}>('../../assets/img/personas/*.png',{eager:true});
const source=images[`../../assets/img/personas/${portrait}.png`]?.default;
if(!source)throw new Error(`Missing persona portrait: ${portrait}`);
---
<article class:list={['persona-card',kind==='fx'?'fx-persona':'authored-persona']}>
 <div class="persona-identity">
  <div class="persona-copy"><h4>{name}</h4><p class="persona-role">{role}</p><blockquote>{quote}</blockquote></div>
  <div class="persona-art"><Picture src={source} alt="" formats={['webp']} widths={[300,600,900]} sizes="(max-width:420px) 75vw, 300px" quality={90} loading="lazy" decoding="async"/></div>
 </div>
 <div class="authored-persona-needs">{groups.map(group=><div><h5>{group.label}</h5><ul>{group.items.map(item=><li>{item}</li>)}</ul></div>)}</div>
</article>
<style>
.persona-card{--fg:#272b32;--fg-2:#4d4644;display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);background:#f5e4dc;color:var(--fg);border-radius:4px;overflow:hidden;isolation:isolate}
.persona-identity{min-width:0;display:flex;flex-direction:column;align-items:center;padding-top:32px}
.persona-copy{width:100%;padding:0 clamp(24px,3vw,40px) 24px}
.persona-copy h4{color:var(--fg);font-size:clamp(28px,2.5vw,38px);line-height:1.15;letter-spacing:-.035em;margin:0 0 12px}
.persona-role{font-size:15px;line-height:1.6;white-space:pre-line;color:var(--fg-2);margin:0}
blockquote{margin:24px 0 0;font-size:18px;line-height:1.6}
.persona-art{width:min(100%,300px);aspect-ratio:3/4;margin:auto 0 0;mix-blend-mode:darken}
.persona-art :global(img){display:block;width:100%;height:100%;object-fit:cover;border-radius:0}
.authored-persona-needs{display:grid;align-content:center;gap:28px;padding:32px clamp(24px,3vw,48px)}
h5{font:600 clamp(18px,1.5vw,24px)/1.3 var(--body);margin:0 0 12px}
ul{list-style:disc;padding-left:1.2em;margin:0;display:grid;gap:8px;color:var(--fg-2);font-size:clamp(16px,1.3vw,20px);line-height:1.6}
@media(max-width:850px){.persona-card{grid-template-columns:1fr}.authored-persona-needs{padding:28px 24px;gap:24px}.persona-copy{padding-inline:24px}.persona-copy h4{font-size:30px}h5{font-size:18px}ul{font-size:16px}}
</style>
