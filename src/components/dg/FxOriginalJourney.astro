---
import content from '../../data/authored-content.json';
import { Image } from 'astro:assets';
import portrait from '../../assets/img/personas/fx-0.png';
const data=content.fx.journey;
const colours=['#aa5400','#a13d2a','#830d37','#b04a9c','#11689c'];
---
<section id="fx-journey" class="authored-journey fx-original-journey" aria-labelledby="fx-journey-title">
  <header class="process-heading">
    <h3 id="fx-journey-title">User journey</h3>
    <p>{data.line}</p>
  </header>
  <div class="journey-context">
    <section class="journey-persona"><h4>Persona</h4><div class="journey-identity"><Image src={portrait} width={64} height={64} alt="" /><div><strong>Dana Chen</strong><p>Senior Execution Trader</p></div></div><p>Buy-side FX desk · London<br />EURUSD · 1M SELL · one session</p></section>
    <section><h4>Scenario</h4><p>{data.scenario}</p></section>
    <section><h4>Goal</h4><p>{data.goal}</p></section>
  </div>
  <div class="journey-original-scroll" tabindex="0" role="region" aria-label="Original FX thoughts, feelings and approach graphic. Scroll horizontally to explore on smaller screens.">
    <div class="journey-artwork-window">
      <img src="/art/fx-journey-original.svg" width="985" height="750" loading="lazy" decoding="async" alt="Dana Chen's original thoughts and feelings map, showing emotional experience, effort, tool switching, and approach feedback loops across the order." />
    </div>
  </div>
  <section class="journey-phases" aria-labelledby="fx-journey-phases-title">
    <h4 id="fx-journey-phases-title">Journey phases</h4>
    {data.phases.map((phase,phaseIndex)=><section class:list={['journey-phase',{'journey-phase-review':phaseIndex===1}]}>
      <header class="phase-heading"><h5>{phase.title}</h5><p>{phase.description}</p></header>
      <ol class="journey-steps" start={phaseIndex===0?1:5}>
        {data.steps.slice(phaseIndex===0?0:4,phaseIndex===0?4:5).map((step,i)=><li style={`--phase-colour:${colours[phaseIndex===0?i:4]}`}>
          <h6><span>{String(phaseIndex===0?i+1:5).padStart(2,'0')}</span>{step.title}</h6>
          <p>{step.description}</p>
          <strong class="recommendation-label">Recommendation</strong>
          <ul>{step.recommendations.map(recommendation=><li>{recommendation}</li>)}</ul>
        </li>)}
      </ol>
    </section>)}
  </section>
</section>
<style>
.fx-original-journey{min-width:0;margin-block:64px 96px;scroll-margin-top:140px}
.journey-context{display:grid;grid-template-columns:1fr 1.4fr 1fr;gap:32px;margin-block:36px 48px}
.journey-context h4{font-size:14px;line-height:1.5;color:#f6ad46;border-top:1px solid #74562f;padding-top:14px;margin:0 0 20px}
.journey-context p,.journey-steps p,.journey-steps ul{font-size:16px;line-height:1.7;color:var(--fg-2);margin:0}
.journey-identity{display:flex;align-items:center;gap:14px;margin-bottom:18px}
.journey-identity img{width:56px;height:56px;object-fit:cover;object-position:center 20%;border-radius:50%}
.journey-identity strong{font-size:18px}.journey-identity p{margin-top:4px}
.journey-original-scroll{overflow-x:auto;overscroll-behavior-x:contain;margin-block:32px 48px}
/* Show the untouched chart and approach portion. Its text sections reflow above and below. */
.journey-artwork-window{position:relative;width:100%;aspect-ratio:985 / 459;overflow:hidden}
.journey-artwork-window img{position:absolute;display:block;width:100%;height:auto;max-width:none;top:calc(-100% * 100.7 / 459);left:0}
.journey-phases>h4{font-size:22px;line-height:1.3;margin:0 0 24px}
.journey-phase{margin-top:40px}.phase-heading{margin-bottom:32px}
.phase-heading h5{font-size:20px;line-height:1.4;margin:0 0 6px}.phase-heading p{font-size:16px;line-height:1.6;color:var(--fg-2);margin:0}

.journey-steps{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:36px 32px;list-style:none;padding:0;margin:0}
.journey-steps>li{border-top:3px solid var(--phase-colour);padding-top:18px;min-width:0}
.journey-steps h6{font-size:20px;line-height:1.4;margin:0 0 16px}.journey-steps h6 span{font-size:13px;color:var(--fg-2);display:block;margin-bottom:8px}
.recommendation-label{display:block;font-size:14px;margin:22px 0 10px}.journey-steps ul{padding-left:20px;list-style:disc}.journey-steps ul li+li{margin-top:6px}
.journey-phase-review{margin-top:64px}.journey-phase-review .journey-steps{grid-template-columns:1fr}
@media(max-width:1000px){.journey-context{grid-template-columns:1fr;gap:28px}}
@media(max-width:760px){.journey-artwork-window{min-width:1100px}}
@media(max-width:600px){.fx-original-journey{margin-block:40px 56px}.journey-steps{grid-template-columns:1fr}.journey-context{margin-block:28px 36px}}
</style>
