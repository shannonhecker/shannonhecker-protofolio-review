---
import content from '../../data/workflow-summaries.json';
interface Props { project: keyof typeof content }
const {project}=Astro.props;
const artwork=import.meta.glob<string>('../../../public/art/workflow-summaries/*.svg',{query:'?raw',import:'default',eager:true});
const summary: {label:string;caption:string;steps:{t:string;d:string;branch?:{t:string;d:string}}[]}=content[project];
---
<section class="workflow-summary" aria-labelledby={`${project}-summary-title`}>
 <div class="summary-heading"><h4 id={`${project}-summary-title`}>Workflow at a glance</h4></div>
 <p class="summary-intro">Illustrated summary · read in numbered order</p>
 <ol aria-label={summary.label}>
  {summary.steps.map((step,index)=><li>
   {(['light','dark'] as const).map(theme=><div class={`summary-art summary-${theme}`} role="img" aria-label={`${index+1}. ${step.t}. ${step.d}${step.branch?` ${step.branch.t}: ${step.branch.d}.`:''}`}><Fragment set:html={artwork[`../../../public/art/workflow-summaries/${project}-${index}-${theme}.svg`]} /></div>)}
  </li>)}
 </ol>
 {summary.caption&&<p class="summary-caption">{summary.caption}</p>}
</section>
<style>
.workflow-summary{margin-top:40px;min-width:0}
.summary-heading{display:flex;justify-content:space-between;align-items:baseline;gap:16px;margin-bottom:12px}
.summary-heading h4{margin:0;font-size:22px;line-height:1.4;font-weight:500;color:var(--fg)}

.summary-intro,.summary-caption{font-size:14px;line-height:1.65;color:var(--fg-2);margin:0 0 20px}
.summary-caption{margin:20px 0 0;max-width:70ch}
ol{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px;list-style:none;padding:0;margin:0}
li{min-width:0;margin:0;padding:0}
.summary-art{width:100%;min-width:0}.summary-art :global(svg){display:block;width:100%;height:auto;max-height:none;border-radius:var(--radius)}.summary-art :global(text){font-family:Inter,Arial,sans-serif}
.summary-dark{display:none}
:global(html[data-theme=dark]) .summary-light{display:none}
:global(html[data-theme=dark]) .summary-dark{display:block}
@media(max-width:760px){ol{grid-template-columns:minmax(0,1fr);gap:20px}.summary-heading{align-items:flex-start;flex-direction:column;gap:8px}.summary-heading h4{font-size:20px}}
</style>
