---
import { Picture } from 'astro:assets';
import { readFileSync } from 'node:fs';
import portraits from '../../assets/img/fx-figma/personas.png';
const steps = [
 {title:'Pre-trade',color:'#aa5400',description:'Dana reviews liquidity windows for the session, chooses the algo and limit, and captures her benchmarks, arrival mid and session TWAP, before the first clip goes out.',recommendations:['Order ticket with percentile presets','Benchmarks captured and frozen on the canvas'],quotes:["Where’s the liquidity today?"]},
 {title:'Staging the order',color:'#a63e2c',description:'She stages the order straight from the chart, dragging the BID pill to a level and reviewing the pre-filled ticket before submitting.',recommendations:['Pill-drag staging','Pre-filled ticket, one check and go'],quotes:['Right level, right size?','Ticket’s pre-filled. One check and go.']},
 {title:'Working passively',color:'#870b33',description:'The algo works. Dana watches percent done against schedule, fills against the market, and the venue mix, without touching anything.',recommendations:['Canvas with pinned tooltip','Passive gauge and venue doughnut'],quotes:['On schedule, without paying the spread?','BARX fills me most. At what cost?']},
 {title:'Intervention',color:'#963780',description:'When the market drifts or a hatched band comes on, she acts from the chart: repricing the limit, flipping aggressive, or excluding a venue.',recommendations:['Reprice','Venue cross-filter'],quotes:['Act now, or wait one more bar?','Repriced. Let it breathe.']},
 {title:'Post-trade review',color:'#11689c',description:'Done. Dana compares the order against its sibling, exports the fills, and writes the best-ex note while the context is fresh.',recommendations:['Compare orders','Table view with CSV export'],quotes:['Can I defend this print?','All in, inside arrival.']},
];
const quotes=steps.flatMap(step=>step.quotes);
const positions=[300,590,700,900,1030,1210,1320,1490,1600];
const levels=[600.08,524.44,545.70,654.04,650.59,584.40,549.85,498.98,491.38];
const stems=['02234','0c537','2cdd2','1476b','fe36f','0fc8a','564c9','a085e','f2418'];
const heights=[229,153,175,283,280,213,179,128,120];
const events=[{x:560,w:187,text:'Order staged from the BID pill'},{x:880,w:162,text:'Suspend band, hands off'},{x:1180,w:100,text:'Limit repriced'},{x:1450,w:151,text:'CSV export for best-ex'}];
// Embed these small authored vectors so below-fold diagram details do not
// open twenty image requests during the hero's first render.
const asset=(name:string)=>`data:image/svg+xml,${encodeURIComponent(readFileSync(`public/art/fx-journey/${name}.svg`,'utf8'))}`;
---
<section id="fx-journey" class="fx-authored-journey" aria-labelledby="fx-journey-title">
  <header class="authored-heading"><h3 id="fx-journey-title">User journey</h3><a href="https://www.figma.com/design/uCUV8a6hZVWo54ko5GrjvJ?node-id=148-8308" target="_blank" rel="noopener">View my Figma journey map<span class="vh"> (opens in new tab)</span> ↗</a></header>
  <div class="journey-context">
    <div><h4>Persona</h4><div class="journey-person"><div class="journey-face"><Picture src={portraits} widths={[500]} formats={['webp']} alt="" loading="lazy" /></div><p><strong>Dana Chen</strong><br/>Senior Execution Trader<br/>Buy-side FX desk · London<br/>EURUSD · 1M SELL · one session</p></div></div>
    <div><h4>Scenario</h4><p>Dana is working a 1M EURUSD sell across the London session. The algo slices it into child orders while she supervises a book of tickets at once. She starts from benchmarks she trusts, arrival mid and session TWAP, and steps in only when the canvas says the order needs her.</p></div>
    <div><h4>Goal</h4><p>Finish inside the benchmarks, stay mostly passive, and defend the execution afterwards.</p></div>
  </div>
  <figure class="journey-experience">
    <div class="journey-plot" tabindex="0" role="region" aria-label="Journey experience and feedback loops, scroll horizontally to explore">
      <svg viewBox="0 180 1760 840" width="1760" height="840" role="img" aria-labelledby="journey-plot-title journey-plot-desc">
        <title id="journey-plot-title">Thoughts, feelings and feedback loops</title>
        <desc id="journey-plot-desc">My qualitative journey map follows Dana’s emotional experience, effort and tool switching. Repricing and venue changes return to working; post-trade learnings feed the next order. Every thought is also readable in the stages below.</desc>
        <rect x="0" y="180" width="1760" height="640" rx="16" fill="#202020" stroke="#3b3f46" />
        <text x="24" y="230" fill="#f5f5f5" font-size="18" font-weight="600">Thoughts &amp; feelings</text>
        <image href={asset('d0ed4')} x="180" y="487.37" width="1511.5" height="293.4" />
        <image href={asset('9c07e')} x="180" y="600.75" width="1511.5" height="180" />
        <image href={asset('9f220')} x="180" y="718.6" width="1511.5" height="62.1" />
        {[{y:366,label:'Quotes'},{y:553,label:'Emotional experience'},{y:656,label:'Effort'},{y:713,label:'Tool switching'}].map(row=><g><text x="24" y={row.y} fill="#c5c9d0" font-size="13">{row.label}</text><image href={asset('e7589')} x="152" y={row.y-4} width="8" height="8"/><line x1="180" y1={row.y} x2="1690" y2={row.y} stroke="#eb9940" stroke-opacity=".25"/></g>)}
        <line x1="180" y1="780" x2="1690" y2="780" stroke="#fff" stroke-opacity=".18"/>
        {positions.map((x,i)=><g><image href={asset(stems[i])} x={x-.5} y="366" width="1" height={heights[i]}/><image href={asset('a3778')} x={x-3} y="363" width="6" height="6"/><image href={asset('f583f')} x={x-5} y={levels[i]-5} width="10" height="10"/><text x={x+2} y="354" transform={`rotate(-35 ${x+2} 354)`} fill="#c5c9d0" font-size="11.5" font-style="italic">“{quotes[i]}”</text></g>)}
        {events.map(event=><g><image href={asset('dbc81')} x={event.x-16} y="739" width="8" height="8"/><rect x={event.x} y="728" width={event.w} height="26" rx="4" fill="#732957"/><text x={event.x+12} y="745" fill="#fff" font-size="11.5">{event.text}</text></g>)}
        <text x="24" y="922" fill="#f5f5f5" font-size="18" font-weight="600">Approach</text>
        <rect x="180" y="850" width="1510" height="150" rx="12" fill="#202020" stroke="#3b3f46"/>
        <line x1="200" y1="950" x2="1670" y2="950" stroke="#eb9940" stroke-opacity=".35"/>
        {[331,633,935,1237,1539].map(x=><image href={asset('de82f')} x={x-6} y="944" width="12" height="12"/>)}
        <image href={asset('1381a')} x="932.1" y="915.5" width="305.387" height="28.5"/>
        <image href={asset('c8694')} x="932.1" y="895.5" width="305.387" height="48.5"/>
        <image href={asset('efc91')} x="327.4" y="873.5" width="1212.18" height="70.5"/>
        {[{x:1010,y:908,w:147,text:'Reprice, return to working'},{x:990,y:887,w:171,text:'Exclude a venue, keep working'},{x:700,y:865,w:243,text:'Post-trade learnings set the next order’s limit'}].map(loop=><g><rect x={loop.x} y={loop.y} width={loop.w} height="19" rx="3" fill="#732957"/><text x={loop.x+8} y={loop.y+13} font-size="10.5" fill="#fff">{loop.text}</text></g>)}
      </svg>
    </div>
    <figcaption>My qualitative journey map. On smaller screens, scroll the diagram sideways; each stage is readable below.</figcaption>
  </figure>
  <div class="journey-phases"><p><b>Work the order</b><span>Supervise one parent order from staging to done</span></p><p><b>Prove it</b><span>Post-trade, order by order</span></p></div>
  <ol class="journey-stages">{steps.map((step,i)=><li style={`--stage-colour:${step.color}`}><h4><span>{String(i+1).padStart(2,'0')}</span>{step.title}</h4><div class="stage-quotes">{step.quotes.map(quote=><p>“{quote}”</p>)}</div><p>{step.description}</p><h5>Recommendation</h5><ul>{step.recommendations.map(item=><li>{item}</li>)}</ul></li>)}</ol>
</section>
<style>
 .fx-authored-journey{min-width:0;margin-block:48px 100px;scroll-margin-top:100px}
 .authored-heading{display:flex;justify-content:space-between;align-items:baseline;gap:16px;flex-wrap:wrap;margin-bottom:36px}.authored-heading h3{font-size:clamp(28px,3vw,42px);letter-spacing:-.03em}.authored-heading a{font-size:14px;color:var(--fg-2)}
 .journey-context{display:grid;grid-template-columns:1fr 1.2fr .85fr;gap:40px;margin-bottom:40px}.journey-context h4{font-size:14px;padding-bottom:12px;border-bottom:1px solid var(--hair);margin-bottom:16px}.journey-context p{font-size:14px;line-height:1.7;color:var(--fg-2)}.journey-person{display:flex;gap:16px}.journey-person strong{color:var(--fg)}
 .journey-face{position:relative;width:60px;height:62px;flex:none;border-radius:50%;overflow:hidden}.journey-face :global(img){position:absolute;width:660.97%;max-width:none;height:315.71%;left:-110.04%;top:-60.36%}
 .journey-experience{margin:0}.journey-plot{overflow:auto;border-radius:var(--radius);background:#161616}.journey-plot svg{display:block;width:100%;min-width:1100px;height:auto;font-family:var(--body)}.journey-experience figcaption{font-size:13px;line-height:1.65;color:var(--fg-2);margin-top:12px}
 .journey-phases{display:grid;grid-template-columns:4fr 1fr;gap:12px;margin-top:36px}.journey-phases p{padding:12px 16px;background:#6b2152;color:white;border-radius:var(--radius);font-size:14px}.journey-phases p:last-child{background:#1c454f}.journey-phases span{display:block;font-size:12px;margin-top:4px}
 .journey-stages{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:20px;margin-top:16px;list-style:none;padding:0}.journey-stages>li{min-width:0}.journey-stages h4{display:flex;gap:8px;align-items:baseline;font-size:15px;line-height:1.4;padding:12px;background:var(--stage-colour);color:#fff;border-radius:var(--radius);min-height:66px}.journey-stages h4 span{font-size:12px}.journey-stages p,.journey-stages li li{font-size:14px;line-height:1.7;color:var(--fg-2)}.stage-quotes{margin-block:20px;min-height:100px}.stage-quotes p{font-style:italic;color:var(--fg)}.journey-stages h5{font-size:14px;margin-block:20px 8px}.journey-stages ul{padding-left:18px;list-style:disc}
 @media(max-width:900px){.journey-context{grid-template-columns:1fr;gap:24px}.journey-stages{grid-template-columns:1fr;gap:32px}.journey-stages h4{min-height:0}.stage-quotes{min-height:0;margin-block:16px}.journey-phases{grid-template-columns:1fr}.journey-phases p:last-child{display:none}.fx-authored-journey{margin-bottom:48px}.journey-stages>li:last-child::before{content:'Prove it · Post-trade, order by order';display:block;background:#1c454f;color:white;padding:12px 16px;margin-bottom:16px;font-size:14px;border-radius:var(--radius)}}
</style>
