---
const nodes: {x:number;y:number;w:number;h:number;lines:string[];tone?:string}[] = [
 {x:440,y:24,w:220,h:48,lines:['Request comes in'],tone:'success'},
 {x:425,y:100,w:250,h:64,lines:['Create the deal','One object, four views'],tone:'accent'},
 {x:70,y:204,w:240,h:64,lines:['Upload the template','Spreadsheet mapped in']},
 {x:430,y:204,w:240,h:64,lines:['Load the portfolio']},
 {x:790,y:204,w:240,h:64,lines:['Start from a default','portfolio']},
 {x:425,y:310,w:250,h:64,lines:['Price and iterate','Checks as you go'],tone:'accent'},
 {x:430,y:412,w:240,h:64,lines:['Compare and tier','Grid, column chooser']},
 {x:60,y:412,w:260,h:80,lines:['Smart pricing (explored)','Model suggests,','person decides'],tone:'accent'},
 {x:780,y:412,w:260,h:80,lines:['Out of tolerance','Fix at the field,','not at approval'],tone:'warning'},
 {x:400,y:532,w:300,h:64,lines:['Approve and sign off','The tool writes the summary'],tone:'success'},
];
---
<svg class="deal-flow-vector" viewBox="0 0 1100 624" role="img" aria-labelledby="deal-flow-title deal-flow-desc" xmlns="http://www.w3.org/2000/svg">
 <title id="deal-flow-title">Deal Model decision flow</title>
 <desc id="deal-flow-desc">Create one deal with four views. Upload a spreadsheet, load a portfolio or start from a default. Price and iterate with checks as you go, compare and tier, then approve and sign off. Smart pricing is an explored suggestion that the person decides on. Out-of-tolerance values return to pricing for correction.</desc>
 <g class="connectors" fill="none" stroke-width="1.5"><path d="M550 72V100M550 164V184M190 204V184H910V204M550 184V204M190 268V288H910V268M550 268V310M550 374V412M550 476V532"/><path stroke-dasharray="5 5" d="M425 342H190V412M190 492V564H400M675 342H910V412M780 452H730V342"/></g>
 {nodes.map(n=><g class:list={['flow-node',n.tone]}><rect x={n.x} y={n.y} width={n.w} height={n.h} rx="4"/><text x={n.x+n.w/2} y={n.y+n.h/2-(n.lines.length-1)*10+5} text-anchor="middle">{n.lines.map((line,i)=><tspan x={n.x+n.w/2} dy={i?20:0}>{line}</tspan>)}</text></g>)}
</svg>
<style>
.deal-flow-vector{display:block;width:100%;min-width:900px;height:auto;padding:24px;border-radius:var(--radius);background:var(--project-wash)}.connectors{stroke:var(--project-ink)}.flow-node rect{fill:var(--bg);stroke:var(--hair);stroke-width:1.5}.flow-node.accent rect{stroke:var(--project-ink)}.flow-node.success rect{stroke:#61917a}.flow-node.warning rect{stroke:#bc902f}.flow-node text{fill:var(--fg);font:15px var(--body)}
</style>
