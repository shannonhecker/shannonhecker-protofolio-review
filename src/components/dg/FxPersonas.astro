---
import PersonaCard from './PersonaCard.astro';
const personas = [
  { name: 'Dana Chen', role: 'Senior Execution Trader, Buy-side FX Desk', quote: 'I need one glance to know whether my order needs me, or whether I’d just be adding noise.', offset: '-2.66%', accent: '#fbd4bb',
    goals: ['Beat arrival mid without burning the spread', 'Keep the passive ratio high yet on schedule', 'Catch venue toxicity before it costs pips'],
    frictions: ['TCA lands after the damage is done', 'Alerts fire without market context', 'Juggling EMS blotter, charts and chat'],
    features: ['Benchmarks + pinned tooltip', 'Reprice & pill-drag staging', 'Venue cross-filter'] },
  { name: 'Marcus Webb', role: 'Head of Trading, Desk Oversight', quote: 'Best execution isn’t a report, it’s something I defend order by order.', offset: '-105.79%', accent: '#f8d0d5',
    goals: ['Defend best execution order by order', 'Compare sibling orders on one canvas', 'Spot venue-mix drift across the desk'],
    frictions: ['Evidence scattered across tools', 'Slippage numbers without a narrative', 'Static end-of-day reporting'],
    features: ['Compare orders', 'Venue analysis chart + table', 'Passive / aggressive gauge'] },
  { name: 'Priya Nair', role: 'Execution Quant, Algo Tuning', quote: 'Give me the complete series and I’ll tell you if the pacing is wrong.', offset: '-211.15%', accent: '#e0d0f1',
    goals: ['Validate pacing against session TWAP', 'Study fill placement vs mid by venue', 'Tune passive / aggressive thresholds'],
    frictions: ['Downsampling hides microstructure', 'Studies polluted by partial series'],
    features: ['Complete bid/ask/mid studies', 'Interval regrouping', 'Table view with CSV export'] },
];
---
<section id="fx-personas" class="fx-authored-personas" aria-labelledby="fx-personas-title">
  <header class="authored-heading"><h3 id="fx-personas-title">User personas</h3><a href="https://www.figma.com/design/uCUV8a6hZVWo54ko5GrjvJ?node-id=92-8088" target="_blank" rel="noopener">View my Figma personas<span class="vh"> (opens in new tab)</span> ↗</a></header>
  <p class="authored-caption">My three design personas: execution, desk oversight and algo tuning. Illustrations, not photographs of research participants.</p>
  <div class="fx-persona-list">
    {personas.map((persona,index)=><PersonaCard kind="fx" name={persona.name} role={persona.role} quote={`“${persona.quote}”`} portrait={`fx-${index}`} groups={[{label:'Goals',items:persona.goals},{label:'Frictions',items:persona.frictions},{label:'In this app',items:persona.features}]}/>)}
  </div>
</section>
<style>
  .fx-authored-personas { min-width:0;margin-block:40px; }
  .authored-heading { display:flex;justify-content:space-between;gap:16px;align-items:baseline;flex-wrap:wrap; }
  .authored-heading h3 { font-size:clamp(28px,3vw,42px);letter-spacing:-.03em; }
  .authored-heading a,.authored-caption { font-size:14px;line-height:1.7;color:var(--fg-2); }
  .authored-caption { margin-top:16px;max-width:70ch; }
  .fx-persona-list { display:grid;gap:48px;margin-top:32px; }
</style>
