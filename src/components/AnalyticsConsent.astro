<aside id="analytics-choice" class="analytics-choice" aria-labelledby="analytics-heading" hidden>
  <h2 id="analytics-heading">Optional analytics</h2>
  <p>I use Google Analytics for visits, reading and game play. Off unless you allow it. Nicknames are never sent to Google.</p>
  <div><button type="button" data-analytics-choice="no">No thanks</button><button type="button" data-analytics-choice="yes">Allow analytics</button><a href="/privacy">Privacy details</a></div>
</aside>
<script>import '../scripts/analytics';</script>
