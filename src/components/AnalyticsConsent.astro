<aside id="analytics-choice" class="analytics-choice" aria-labelledby="analytics-heading" hidden>
  <h2 id="analytics-heading">Optional analytics</h2>
  <p>I use Google Analytics for visits, reading and game play. Off unless you allow it. Nicknames are never sent to Google.</p>
  <div><button type="button" data-analytics-choice="no">No thanks</button><button type="button" data-analytics-choice="yes">Allow analytics</button><a href="/privacy">Privacy details</a></div>
</aside>
<script is:inline>
  // Set visibility before first paint, without waiting for the analytics module.
  // This only reads the saved preference; tracking still requires explicit consent.
  (() => {
    let saved = false;
    try {
      const value = JSON.parse(localStorage.getItem('portfolio-analytics-v1') || 'null');
      saved = !!value && Date.now() - value.at < 180 * 86400000;
    } catch {}
    const panel = document.getElementById('analytics-choice');
    if (panel) panel.hidden = saved;
  })();
</script>
<script>import '../scripts/analytics';</script>
<style>
.analytics-choice{position:fixed;z-index:120;bottom:20px;left:20px;width:min(480px,calc(100vw - 40px));padding:24px;border:1px solid #b78b73;border-radius:var(--radius);background:#fffaf2;color:#343b46;box-shadow:0 8px 40px #343b461a;font:400 15px/1.6 Inter,sans-serif}
.analytics-choice[hidden]{display:none}.analytics-choice h2{font:500 22px/1.3 var(--display);margin:0 0 10px;letter-spacing:0}.analytics-choice p{font:inherit;margin:0 0 18px}.analytics-choice div{display:flex;gap:12px;flex-wrap:wrap;align-items:center}.analytics-choice button{padding:10px 16px;border:1px solid #9b4e65;border-radius:var(--radius);background:#fffaf2;color:#71384b;font:600 14px/1.5 Inter,sans-serif;cursor:pointer;min-height:44px}.analytics-choice a{color:#71384b;text-decoration:underline;font-size:13px}
</style>
<style>
.analytics-choice{width:min(400px,calc(100vw - 32px));padding:18px;left:16px;bottom:16px;border-radius:var(--radius);font-size:13px;box-shadow:none;background:#fff}.analytics-choice h2{font-size:18px}.analytics-choice button{font-size:13px;padding:8px 12px;border-radius:var(--radius);background:#fff}.analytics-choice div{gap:8px}.analytics-choice p{margin-bottom:12px}
</style>
