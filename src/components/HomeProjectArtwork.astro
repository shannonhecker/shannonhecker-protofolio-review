---
import { Picture } from 'astro:assets';
import { imageWidths } from '../lib/image-widths';
import fx from '../assets/img/home-figma/fx.png';
import fusion from '../assets/img/home-figma/fusion.png';
import winking from '../assets/img/home-figma/winking.png';
import winkingMobile from '../assets/img/home-figma/winking-mobile.png';
import dealMobile from '../assets/img/home-figma/deal-mobile.png';
import ai from '../assets/img/home-figma/uoaui.png';
interface Props { project:string }
const {project}=Astro.props;
const artwork={fx,fusion,winking,ai}[project];
---
<div class={`project-preview home-artwork home-artwork-${project}`}>
 {project==='deal' && <picture><img src="/art/home-deal.svg" alt="" width="681" height="524" loading="lazy" decoding="async" /></picture>}
 {project==='deal' && <Picture class="mobile-artwork" src={dealMobile} alt="" formats={['avif','webp']} quality={85} widths={imageWidths(dealMobile.width)} sizes="100vw" loading="lazy" decoding="async" />}
 {artwork && <Picture src={artwork} alt="" formats={['avif','webp']} quality={85} widths={imageWidths(artwork.width)} sizes={project==='fx'?'(max-width:760px) 110vw, (min-width:1680px) 982px, 59vw':'(max-width:760px) 100vw, (min-width:1680px) 776px, 47vw'} loading="lazy" decoding="async" />}
 {project==='winking' && <Picture class="mobile-artwork" src={winkingMobile} alt="" formats={['avif','webp']} quality={85} widths={imageWidths(winkingMobile.width)} sizes="90vw" loading="lazy" decoding="async" />}
</div>
