---
import { adaptiveArt } from '../lib/adaptive-art';
interface Props { project:string }
const {project}=Astro.props;
const desktop=adaptiveArt(`/art/home-${project}-composition-current.svg`);
const mobile=adaptiveArt(`/art/home-${project}-composition-mobile-current.svg`);
const mobileHeight=project==='winking'?350*524/681:project==='fx'?269:270;
const responsive=project!=='deal';
const extension='svg';
const srcset=(variant:string)=>[400,800,1200,1600,2000].map(w=>`${adaptiveArt(`/art/home-responsive/${project}-${variant}-${w}.${extension}`)} ${w}w`).join(', ');
const sizes='(max-width:760px) calc(100vw - 48px), (min-width:1680px) 780px, calc(46.6vw - 3px)';
---
<div class={`project-preview home-artwork home-artwork-${project} exact-composition`} style={`--mobile-ratio:350/${mobileHeight}`}>
 <picture><source media="(max-width:760px)" srcset={responsive?srcset(project==='winking'?'current':'mobile-current'):mobile} sizes={sizes} width="350" height={mobileHeight}/><img src={responsive?adaptiveArt(`/art/home-responsive/${project}-current-800.${extension}`):desktop} srcset={responsive?srcset('current'):undefined} sizes={responsive?sizes:undefined} alt="" width="681" height="524" loading="lazy" decoding="async" /></picture>
</div>
<style>
:global(#work .home-artwork.exact-composition){aspect-ratio:681/524;background:transparent;content-visibility:auto}
:global(#work .home-artwork-winking.exact-composition),:global(.next-project-row .home-artwork-winking.exact-composition){background:#efe2d2;border-radius:var(--radius);overflow:hidden}
:global(html[data-theme=dark] #work .home-artwork-winking.exact-composition),:global(html[data-theme=dark] .next-project-row .home-artwork-winking.exact-composition){background:#efe2d2}
:global(#work .home-artwork-deal.exact-composition),:global(.next-project-row .home-artwork-deal.exact-composition){background:#d9dada;border-radius:var(--radius);overflow:hidden}
:global(html[data-theme=dark] #work .home-artwork-deal.exact-composition),:global(html[data-theme=dark] .next-project-row .home-artwork-deal.exact-composition){background:#d9dada}
:global(#work .home-artwork.exact-composition picture){display:block;inset:0;width:100%;height:100%}
:global(#work .home-artwork.exact-composition img){object-fit:contain}
@media(max-width:760px){:global(#work .home-artwork.exact-composition){aspect-ratio:var(--mobile-ratio)}}
</style>
